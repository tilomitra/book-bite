# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# New York Times API
NYT_API_KEY=your_nyt_api_key

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# Redis Configuration (for job queue)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:8100

# Optional: model for Ask answers (default gpt-6-luna)
# ASK_MODEL=gpt-6-luna

# Optional: Gemini TTS variant in `npm run generate-audio -- --compare` (Google AI Studio key)
# GEMINI_API_KEY=

# Optional: affiliate ids for "Get the full book" links (plain store links without them)
# AMAZON_ASSOCIATE_TAG=bookbite-20
# BOOKSHOP_AFFILIATE_ID=12345

# Optional: invite links (/invite/<code>) and where they send people to get the app
# PUBLIC_BASE_URL=https://book-bite.onrender.com
# APP_STORE_URL=https://apps.apple.com/app/id0000000000
