<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BookBiteServerURL</key>
	<string>$(BOOKBITE_SERVER_URL)</string>
	<key>PostHogProjectKey</key>
	<string>$(POSTHOG_PROJECT_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Bookgist connects to a development server on your local network.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>tilo.BookBite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bookbite</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
